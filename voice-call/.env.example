PORT=8787
PUBLIC_URL=https://call.quietfire.cloud
# 随机长字符串,调用 /api/ring 时用 Authorization: Bearer <RING_TOKEN>
RING_TOKEN=

# Telegram(上海服务器直连不通,把 API_BASE 指向你的中转;能直连则留默认)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_API_BASE=https://api.telegram.org

# ElevenLabs(同上)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_v3
ELEVENLABS_BASE_URL=https://api.elevenlabs.io
# 她说的话也交给 ElevenLabs 转文字(安卓不能用浏览器自带识别)
ELEVENLABS_STT_MODEL=scribe_v1

# 大脑:Claude API(和 claude.ai 订阅分开计费,在 console.anthropic.com 申请)
# 上海服务器同样需要能出海,不通时把 BASE_URL 指向中转
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
CLAUDE_MODEL=claude-sonnet-5-5
# Ezra 项目的人设/指令,复制进这个文件
PERSONA_FILE=./persona.md

# (可选,替代 Claude API)你的聊天系统:每句话 POST {call_id,event:answered|user|ended,text,history} -> {"reply":"..."}
LLM_WEBHOOK_URL=
LLM_WEBHOOK_TOKEN=

RETAIN_DAYS=30
