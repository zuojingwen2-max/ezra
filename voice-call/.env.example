PORT=8787
PUBLIC_URL=https://call.example.com
# 随机长字符串,调用 /api/ring 时用 Authorization: Bearer <RING_TOKEN>
RING_TOKEN=

# Telegram(上海服务器直连不通,把 API_BASE 指向你的中转;能直连则留默认)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_API_BASE=https://api.telegram.org

# ElevenLabs(同上)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_v3
ELEVENLABS_BASE_URL=https://api.elevenlabs.io

# 你的聊天系统:每句话 POST {call_id,event:answered|user|ended,text,history} -> {"reply":"..."}
LLM_WEBHOOK_URL=
LLM_WEBHOOK_TOKEN=

RETAIN_DAYS=30
